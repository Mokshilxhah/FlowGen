# FlowGen — Line-ending normalization
# Ensures consistent LF line endings in the repo across Windows / macOS / Linux

* text=auto eol=lf

# Explicitly force LF for these file types
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.py    text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
Procfile text eol=lf

# Binary — never modify
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.db    binary
*.sqlite3 binary
