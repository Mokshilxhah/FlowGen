# FlowGen AI Service Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file.

# ─── Django Core ─────────────────────────────────────────────
SECRET_KEY=your_django_secret_key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-render-domain.onrender.com

# ─── Database ────────────────────────────────────────────────
# SQLite (development default)
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (production — uncomment and set)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ─── Node.js Backend Integration ────────────────────────────
NODE_BACKEND_URL=http://localhost:5000/api/v1
NODE_BACKEND_API_KEY=your_secure_api_key_here

# ─── CORS ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# ─── Google Gemini ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── OpenAI (optional) ───────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── Celery / Redis (optional, for async tasks) ──────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── ML Models ───────────────────────────────────────────────
ML_MODELS_PATH=./ml_models
